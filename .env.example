# ---- required ----
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---- required once it's on a public domain ----
# The one password you both use to get in. Leave blank to run with no lock screen.
APP_PASSWORD=
# Any long random string. Used to sign the login cookie.
SECRET_KEY=

# ---- only when hosting (Vercel sets these for you) ----
# Postgres connection string. Without it the app uses a local SQLite file.
DATABASE_URL=
# Vercel Blob token. Without it photos are saved to static/uploads/.
BLOB_READ_WRITE_TOKEN=

# ---- optional ----
# Any model id from https://openrouter.ai/models
# OPENROUTER_MODEL=google/gemini-2.5-flash
